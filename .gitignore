# OS files
.DS_Store
Thumbs.db
db.sqlite3-journal

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
env/
ENV/
backend/venv/
backend/.venv/
backend/env/
backend/db.sqlite3

# Node/Vite
node_modules/
dist/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
*.local

# Environment variables (except settings.local.json if it's meant to be pushed, which it is since the user wants rules and config)
# Note: we explicitly allow .claude/settings.local.json
.env
.env*.local
backend/.env
frontend/.env
frontend/.env*.local

# IDE/Editors (optional but recommended to ignore)
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Ensure agent and cursor/claude rule folders are tracked
!.cursor/
!.cursor/rules/
!.cursor/rules/*
!.claude/
!.claude/rules/
!.claude/rules/*
!.claude/settings.local.json
!.claude/CLAUDE.md
!agent-rules/
!agent-rules/*
