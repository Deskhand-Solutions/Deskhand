{
  "name": "Only feature branches can be created",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [],
  "conditions": {
    "ref_name": {
      "include": ["~ALL"],
      "exclude": [
        "refs/heads/main",
        "refs/heads/develop",
        "refs/heads/feature/**"
      ]
    }
  },
  "rules": [
    {
      "type": "creation"
    }
  ]
}
